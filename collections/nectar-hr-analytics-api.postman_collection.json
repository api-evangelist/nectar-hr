          "id": "f2499459-bc1d-49cb-8be1-ef51ecc10e29",
          "name": "Generates a summary of redemptions made by all users.",
          "request": {
            "name": "Generates a summary of redemptions made by all users.",
            "description": {
              "content": "Date rules:\n<ul>\n  <li>If you do not specify a start or end date, it will generate a report of the first of the current month to present.</li>\n  <li>If you specify a start date and an end date, they cannot span more than a year.</li>\n  <li>If you specify a start date without an end date, it will fetch either a month from start date, or the current day. Whichever is less.</li>\n  <li>If you specify an end date without a start date, it will error.</li>\n</ul>\nAll requests will include the applied start and end date.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "analytics",
                "financial",
                "redemptions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>,<string>",
                  "description": "Return each users' expanded data"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sorts output by specified value in descending order."
                },
                {
                  "disabled": false,
                  "key": "start-date",
                  "value": "<date>",
                  "description": "Start Date of range to get data from as defined by RFC 3339,\nsection 5.6, for example, 2017-07-21."
                },
                {
                  "disabled": false,
                  "key": "end-date",
                  "value": "<date>",
                  "description": "End Date of range to get data from as defined by RFC 3339,\nsection 5.6, for example, 2017-07-21.\nIf defined, start-date is required."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
